<Window x:Class="WindowTinter.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:WindowTinter.Views"
        Title="暗幕 v7.2.0" Width="640" Height="720" MinWidth="616" MinHeight="560"
        Background="{StaticResource WinBg}"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Microsoft YaHei UI" Foreground="{StaticResource Text1}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" CornerRadius="23"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 搜索框：28 高，内嵌放大镜 + 占位文案（仅在 Text 为空时显示） -->
        <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}">
            <Setter Property="Width" Value="196"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="bd" Background="{StaticResource ControlBg}"
                                    BorderBrush="{StaticResource LineSoftHover}" BorderThickness="1" CornerRadius="8">
                                <Grid Margin="9,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="13"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="13" Height="13" VerticalAlignment="Center">
                                        <Ellipse Width="9" Height="9" Stroke="{StaticResource Text3}" StrokeThickness="1.3"
                                                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,1,0,0"/>
                                        <Rectangle Width="5" Height="1.3" Fill="{StaticResource Text3}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,2"
                                                   RenderTransformOrigin="0,0.5">
                                            <Rectangle.RenderTransform>
                                                <RotateTransform Angle="45"/>
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                    </Grid>
                                    <ScrollViewer x:Name="PART_ContentHost" Grid.Column="2" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ph" Grid.Column="2" Text="搜索标题或别名" FontSize="10.5"
                                               Foreground="{StaticResource Text3}" VerticalAlignment="Center"
                                               IsHitTestVisible="False" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Text.Length, RelativeSource={RelativeSource TemplatedParent}}" Value="0">
                                <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource LineStrong}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 卡片：正常 / 未找到 / 暂停三态 + 选中内联展开 -->
        <DataTemplate x:Key="TargetCardTemplate">
            <Border Margin="0" CornerRadius="23" BorderThickness="1" Focusable="True" Cursor="Hand"
                    PreviewMouseLeftButtonUp="Card_PreviewMouseLeftButtonUp" KeyDown="Card_KeyDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource CardBg}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource LineSoft}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource CardHoverBg}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource LineSoftHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{StaticResource CardSelBg}"/>
                                <Setter Property="BorderBrush" Value="#660A84FF"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ── 行：88×48 缩略图 + 标题 + 副行 + 展开箭头 ── -->
                    <Grid Grid.Row="0" Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="shotBox" Grid.Column="0" Width="88" Height="48" CornerRadius="8"
                                Background="{StaticResource InsetBg}" BorderBrush="#0FFFFFFF" BorderThickness="1"
                                Padding="4" VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Grid>
                                <Border CornerRadius="6" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding ShotImage}" Stretch="Uniform"/>

                                        <!-- 占位：窗口未找到 / 未能抓取 -->
                                        <Border x:Name="shotPlaceholder" CornerRadius="6"
                                                Background="{StaticResource ShotPlaceholderBg}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasShot}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Rectangle Stroke="{StaticResource ShotPlaceholderLine}" StrokeThickness="1"
                                                           StrokeDashArray="3 2" RadiusX="6" RadiusY="6"/>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path Width="16" Height="12" HorizontalAlignment="Center"
                                                          Data="M1,1 L15,1 L15,11 L1,11 Z M1,4 L15,4"
                                                          Stroke="{StaticResource Text3}" StrokeThickness="1"/>
                                                    <TextBlock Text="{Binding PlaceholderText}" FontSize="9.5"
                                                               Foreground="{StaticResource Text3}" HorizontalAlignment="Center"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- 刷新中：保留上一帧，只转细弧，不闪骨架 -->
                                        <Path x:Name="spinArc" Width="12" Height="12" HorizontalAlignment="Right"
                                              VerticalAlignment="Top" Margin="0,2,2,0"
                                              Data="M1,6 A5,5 0 0 1 6,1" Stroke="{StaticResource Accent}" StrokeThickness="1.4"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Style>
                                            </Path.Style>
                                            <Path.RenderTransform>
                                                <RotateTransform x:Name="spinRotate" Angle="0"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                </Border>

                                <!-- 停用态：中性灰蒙层（WPF 无内置去饱和效果，用灰罩 + 降透明近似「降饱和」） -->
                                <Border x:Name="dimVeil" CornerRadius="6" Background="#5988888F" IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!-- 1px inset 描边 -->
                                <Border CornerRadius="6" BorderBrush="#1AFFFFFF" BorderThickness="1" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <StackPanel x:Name="textCol" Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding WindowName}" FontSize="12.5" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <Ellipse Grid.Column="1" Width="6" Height="6" Margin="8,1,0,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource Off}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StateTone}" Value="ok">
                                                    <Setter Property="Fill" Value="{StaticResource Ok}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#30D158" BlurRadius="7" ShadowDepth="0" Opacity="0.8"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StateTone}" Value="warn">
                                                    <Setter Property="Fill" Value="{StaticResource Warn}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Border Grid.Column="2" Background="{StaticResource BadgeBg}" BorderBrush="{StaticResource BadgeBorder}"
                                        BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding AliasVisible}">
                                    <TextBlock Text="自定义" FontSize="9" Foreground="{StaticResource BadgeText}"/>
                                </Border>
                            </Grid>

                            <!-- 副行：单行省略，窄卡片（双列）下不横向溢出 -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding MetaLine}" FontSize="10.5"
                                           Foreground="{StaticResource Text3}" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <!-- 已自定义：该卡不再跟随全局默认值 -->
                                    <Border Background="{StaticResource AccentSoft}" BorderBrush="#4D0A84FF" BorderThickness="1"
                                            CornerRadius="4" Padding="4,0" VerticalAlignment="Center"
                                            Visibility="{Binding CustomizedVisible}">
                                        <TextBlock Text="已自定义" FontSize="9" Foreground="{StaticResource Accent}"/>
                                    </Border>
                                    <Border Background="#26FF9F0A" BorderBrush="#4DFF9F0A" BorderThickness="1"
                                            CornerRadius="4" Padding="4,0" Margin="4,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding DisabledVisible}">
                                        <TextBlock Text="已停用" FontSize="9" Foreground="{StaticResource Warn}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- 单卡开关：32×20，停用只影响这一张卡片（保留配置与位置） -->
                        <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" Width="32" Height="20"
                                      Margin="0,0,6,0" VerticalAlignment="Center"
                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                      ToolTip="停用只关闭这张卡片的压暗，配置与位置保留"/>

                        <!-- chevron：独立的折叠/展开按钮（24×24 热区，悬停高亮 + 手型），不触发整卡选中手势 -->
                        <Button Grid.Column="3" Width="24" Height="24" Margin="0,0,4,0" VerticalAlignment="Center"
                                Focusable="False" Cursor="Hand" ToolTip="折叠 / 展开"
                                Click="Card_Caret_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverFill}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource PressFillDark}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <Path x:Name="caretPath" Width="16" Height="16" Data="M4,6 L8,10 L12,6" Stroke="{StaticResource Text3}"
                                  StrokeThickness="1.8" StrokeLineJoin="Round" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="caretRotate" Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </Button>
                    </Grid>

                    <!-- ── 内联展开：选中卡片后直接出现滑块（无右侧检查器）── -->
                    <StackPanel Grid.Row="1">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Border Height="1" Background="{StaticResource LineSoft}" Margin="12,0"/>

                        <Grid Height="32" Margin="12,6,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="压暗强度" FontSize="10" Foreground="{StaticResource Text3}" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Margin="12,0" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5"
                                    Value="{Binding DataContext.BackgroundAlpha, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}"/>
                            <Border Grid.Column="2" Height="22" CornerRadius="5" Background="{StaticResource InsetBg}"
                                    BorderBrush="{StaticResource LineSoftHover}" BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DataContext.BackgroundAlphaText, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                           FontSize="10" Foreground="{StaticResource Text2}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <Grid Height="32" Margin="12,6,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="圆角半径" FontSize="10" Foreground="{StaticResource Text3}" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Margin="12,0" Minimum="0" Maximum="32" SmallChange="1" LargeChange="4"
                                    Value="{Binding DataContext.CornerRadius, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}"/>
                            <Border Grid.Column="2" Height="22" CornerRadius="5" Background="{StaticResource InsetBg}"
                                    BorderBrush="{StaticResource LineSoftHover}" BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DataContext.CornerRadiusText, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                           FontSize="10" Foreground="{StaticResource Text2}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <Grid Margin="12,6,12,12">
                            <TextBlock Text="{Binding FollowStateText}"
                                       FontSize="9.5" Foreground="{StaticResource Text3}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,200,0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="重命名" Style="{StaticResource LinkButton}" Command="{Binding RenameCommand}"/>
                                <Button Content="恢复全局" Margin="4,0,0,0" Command="{Binding DataContext.RestoreGlobalCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCustomized}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="删除目标" Style="{StaticResource LinkButtonDanger}" Margin="4,0,0,0"
                                        Command="{Binding RemoveCommand}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <!-- 单卡停用：缩略图与文字变暗，开关本身保持清晰（它是恢复入口） -->
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter TargetName="shotBox" Property="Opacity" Value="0.6"/>
                    <Setter TargetName="textCol" Property="Opacity" Value="0.5"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="caretPath" Property="RenderTransform">
                        <Setter.Value>
                            <RotateTransform Angle="90"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                    <Setter TargetName="spinArc" Property="Visibility" Value="Visible"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="spinStoryboard">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="spinRotate" Storyboard.TargetProperty="Angle"
                                                 From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="spinStoryboard"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootFrame" Background="{StaticResource WinBg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14">
        <Grid x:Name="RootContent">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- ═══ ① 标题栏 48（Windows 版式：左标题 16，右上角窗控 46×32）═══ -->
            <Grid Grid.Row="0" Background="{StaticResource TitleBarBg}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="16,0,8,0">
                    <TextBlock Text="暗幕" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TargetSubtitle}" FontSize="9.5" Foreground="{StaticResource Text3}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource BtnIcon}" Margin="0,0,8,0" ToolTip="设置"
                        Command="{Binding OpenSettingsCommand}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Canvas Width="18" Height="18">
                        <Rectangle Canvas.Left="2" Canvas.Top="4" Width="14" Height="1" Fill="{StaticResource Text2}"/>
                        <Rectangle Canvas.Left="2" Canvas.Top="9" Width="14" Height="1" Fill="{StaticResource Text2}"/>
                        <Rectangle Canvas.Left="2" Canvas.Top="14" Width="14" Height="1" Fill="{StaticResource Text2}"/>
                        <Ellipse Canvas.Left="10" Canvas.Top="2.5" Width="4" Height="4" Fill="{StaticResource Text2}"/>
                        <Ellipse Canvas.Left="5" Canvas.Top="7.5" Width="4" Height="4" Fill="{StaticResource Text2}"/>
                        <Ellipse Canvas.Left="10" Canvas.Top="12.5" Width="4" Height="4" Fill="{StaticResource Text2}"/>
                    </Canvas>
                </Button>

                <!-- 窗控：整块在 chrome 上可命中（否则会落到拖动区）-->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource BtnCaption}" ToolTip="最小化" Click="OnMinClick">
                        <Canvas Width="10" Height="10">
                            <Path Data="M0.5,5.5 H9.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1"/>
                        </Canvas>
                    </Button>

                    <Button Style="{StaticResource BtnCaption}" ToolTip="最大化 / 还原" Click="OnMaxClick">
                        <Canvas Width="10" Height="10">
                            <Path Data="M0.5,0.5 H9.5 V9.5 H0.5 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Value="Maximized">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <Path Data="M2.5,0.5 H9.5 V7.5 M0.5,2.5 H7.5 V9.5 H0.5 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Value="Maximized">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Canvas>
                    </Button>

                    <Button Style="{StaticResource BtnCaptionClose}" ToolTip="关闭" Click="OnCloseClick">
                        <Canvas Width="10" Height="10">
                            <Path Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1"/>
                        </Canvas>
                    </Button>
                </StackPanel>

                <Border Grid.ColumnSpan="3" Height="1" Background="{StaticResource LineSoft}" VerticalAlignment="Bottom"/>
            </Grid>

            <!-- ═══ ② 工具栏 56（空状态整行隐藏）═══ -->
            <Grid Grid.Row="1" Margin="16,0,0,0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 分段筛选 28 高 -->
                <Border Grid.Column="0" Background="#0BFFFFFF" BorderBrush="#0DFFFFFF" BorderThickness="1"
                        CornerRadius="9" Padding="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Style="{StaticResource SegToggle}" IsChecked="{Binding IsFilterAllChecked, Mode=TwoWay}" Margin="0,0,2,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="全部" FontSize="10.5"/>
                                <TextBlock Text="{Binding TotalCount}" FontSize="9" Foreground="{StaticResource Text3}"
                                           Margin="5,1,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource SegToggle}" IsChecked="{Binding IsFilterActiveChecked, Mode=TwoWay}" Margin="0,0,2,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="生效中" FontSize="10.5"/>
                                <TextBlock Text="{Binding ActiveCount}" FontSize="9" Foreground="{StaticResource Text3}"
                                           Margin="5,1,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource SegToggle}" IsChecked="{Binding IsFilterPendingChecked, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="未连接" FontSize="10.5"/>
                                <TextBlock Text="{Binding PendingCount}" FontSize="9" Foreground="{StaticResource Text3}"
                                           Margin="5,1,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <!-- 右侧组：弹性留白 + 刷新（图标+文字）+ 搜索框（宽度固定，按钮不被压扁） -->
                <Grid Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1" Style="{StaticResource BtnSmall}" Foreground="{StaticResource Text2}"
                            ToolTip="刷新所有卡片快照" Command="{Binding RefreshSnapshotsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="13" Height="13" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Viewbox.RenderTransform>
                                    <RotateTransform/>
                                </Viewbox.RenderTransform>
                                <Viewbox.Style>
                                    <Style TargetType="Viewbox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="spinStory">
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                From="0" To="360" Duration="0:0:1.1" RepeatBehavior="Forever"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="spinStory"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Viewbox.Style>
                                <Canvas Width="16" Height="16">
                                    <Path Data="M13.6,8 A5.6,5.6 0 1 1 8,2.4" Stroke="{StaticResource Text2}" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Path Data="M10.9,0.4 L10.9,4.4 L14.6,2.6 Z" Fill="{StaticResource Text2}"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="刷新" FontSize="10.5" Foreground="{StaticResource Text2}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBox Grid.Column="3" Style="{StaticResource SearchBox}" VerticalAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </Grid>

            <!-- ═══ ③ 列表区（表头 36 + 可滚动卡片 + 全局条 44）═══ -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,0,16,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <TextBlock Text="已绑定目标" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Text2}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="选中卡片即可调整参数" FontSize="9.5" Foreground="{StaticResource Text3}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="16,0,6,16">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource DarkScrollViewer}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding TargetsView}" ItemTemplate="{StaticResource TargetCardTemplate}"
                                      Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- 1/2 列自适应；双列时选中的卡片占满整行（保证内联滑块行程） -->
                                    <views:CardsPanel Columns="{Binding CardsPerRow}" SelectedItem="{Binding SelectedTarget}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- 空状态 -->
                <Grid Grid.Row="1">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400">
                        <Canvas Width="132" Height="104" HorizontalAlignment="Center">
                            <Border Canvas.Left="14" Canvas.Top="14" Width="96" Height="70" CornerRadius="23"
                                    Background="#1A1D24" BorderBrush="#1FFFFFFF" BorderThickness="1"/>
                            <Rectangle Canvas.Left="30" Canvas.Top="34" Width="40" Height="4" RadiusX="2" RadiusY="2" Fill="#33FFFFFF"/>
                            <Rectangle Canvas.Left="30" Canvas.Top="46" Width="56" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#1FFFFFFF"/>
                            <Rectangle Canvas.Left="30" Canvas.Top="55" Width="30" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#1FFFFFFF"/>
                            <Path Canvas.Left="86" Canvas.Top="60" Data="M0,0 L16,7 L9,9.5 L6,17 L3,16 L6,9 Z"
                                  Fill="{StaticResource Accent}" Stroke="#FFFFFF" StrokeThickness="1.2"/>
                        </Canvas>
                        <TextBlock Text="还没有绑定任何窗口" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        <TextBlock Text="点击右下角「拾取目标窗口」，选中后它会自动变暗。效果只作用于你选中的那个窗口，不影响系统设置。"
                                   FontSize="10.5" Foreground="{StaticResource Text3}" TextAlignment="Center" TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ═══ ④ 全局默认（底栏上方的独立折叠区，不与底栏按钮混排）═══ -->
            <Border Grid.Row="3" Background="{StaticResource FooterBg}"
                    BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0">
                <StackPanel>

                    <!-- 折叠头（40 高整行可点）：左标题 + 已自定义/跟随全局摘要 + 箭头 -->
                    <ToggleButton IsChecked="{Binding GlobalPanelExpanded, Mode=TwoWay}"
                                  Focusable="False" Cursor="Hand" Height="40"
                                  ToolTip="展开 / 收起全局默认参数">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="bd" Background="Transparent">
                                    <Grid Margin="16,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="全局默认" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Text2}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CustomSummaryText}" FontSize="9.5"
                                                   Foreground="{StaticResource Text3}" VerticalAlignment="Center"
                                                   Margin="10,0,8,0" TextTrimming="CharacterEllipsis"/>
                                        <Path Grid.Column="2" x:Name="chev" Width="12" Height="12"
                                              Data="M2.5,4.5 L6,8 L9.5,4.5" Stroke="{StaticResource Text3}"
                                              StrokeThickness="1.6" StrokeLineJoin="Round"
                                              RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverFill}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="chev" Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="180"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <!-- 折叠内容：Collapsed 时不占高度；折叠状态由 GlobalPanelExpanded 持久化 -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GlobalPanelExpanded}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel Margin="16,2,16,14">
                            <Grid Height="26">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="压暗强度" FontSize="10" Foreground="{StaticResource Text3}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Margin="12,0" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5"
                                        Value="{Binding GlobalAlpha, Mode=TwoWay}"/>
                                <Border Grid.Column="2" Height="22" CornerRadius="5" Background="{StaticResource InsetBg}"
                                        BorderBrush="{StaticResource LineSoftHover}" BorderThickness="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding GlobalAlphaText}" FontSize="10" Foreground="{StaticResource Text2}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <Grid Height="26" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="圆角半径" FontSize="10" Foreground="{StaticResource Text3}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Margin="12,0" Minimum="0" Maximum="32" SmallChange="1" LargeChange="4"
                                        Value="{Binding GlobalCorner, Mode=TwoWay}"/>
                                <Border Grid.Column="2" Height="22" CornerRadius="5" Background="{StaticResource InsetBg}"
                                        BorderBrush="{StaticResource LineSoftHover}" BorderThickness="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding GlobalCornerText}" FontSize="10" Foreground="{StaticResource Text2}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="推荐 14 px · 只作用于仍跟随全局的卡片"
                                           FontSize="9.5" Foreground="{StaticResource Text3}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1" Content="全部恢复跟随全局" Margin="8,0,0,0"
                                        Command="{Binding ResetAllToGlobalCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasCustomized}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══ ⑤ 底栏 64 ═══ -->
            <Grid Grid.Row="4" Background="{StaticResource FooterBg}">
                <Border Height="1" Background="{StaticResource LineSoft}" VerticalAlignment="Top"/>
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                      ToolTip="暂停后所有目标立即还原"/>
                        <TextBlock Text="启用" FontSize="9.5" Foreground="{StaticResource Text3}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <Ellipse Width="6" Height="6" Margin="14,0,0,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Off}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FooterTone}" Value="ok">
                                            <Setter Property="Fill" Value="{StaticResource Ok}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FooterTone}" Value="warn">
                                            <Setter Property="Fill" Value="{StaticResource Warn}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ActiveSummary}" FontSize="10.5" Foreground="{StaticResource Text2}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding MissingSummary}" FontSize="10.5" Foreground="{StaticResource Warn}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <!-- 圆角调参读数：只有调过才出现（DebugCorner 段落盘后），正常用户看不到 -->
                        <TextBlock x:Name="CornerDebugText" FontSize="9.5" Foreground="{StaticResource Text3}"
                                   VerticalAlignment="Center" Margin="14,0,0,0" Visibility="Collapsed"
                                   ToolTip="圆角调试：Ctrl+Alt+↑↓ 外轮廓 · ←→ 裁切 · 再加 Shift+↑↓ 内缩 / ←→ 描边弧（±1px，即时生效）"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource BtnPrimary}" Height="32" Command="{Binding AddWindowCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Canvas Width="14" Height="14" VerticalAlignment="Center">
                                    <Rectangle Canvas.Left="6.2" Canvas.Top="1" Width="1.6" Height="12" Fill="White"/>
                                    <Rectangle Canvas.Left="1" Canvas.Top="6.2" Width="12" Height="1.6" Fill="White"/>
                                </Canvas>
                                <TextBlock Text="拾取目标窗口" FontSize="11" FontWeight="SemiBold" Foreground="White"
                                           Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
