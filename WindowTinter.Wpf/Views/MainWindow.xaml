<Window x:Class="WindowTinter.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="暗幕 v5.6.0" Width="484" Height="704" MinWidth="484" MinHeight="704"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="10">
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="196"/>
            <RowDefinition Height="44"/>
            <RowDefinition Height="48"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ ① 状态条 ═══ -->
        <Border Grid.Row="0" Background="{StaticResource Card}" CornerRadius="8" Padding="14,0" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" FontSize="14.5" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="ⓘ" FontSize="13" Foreground="{StaticResource Text3}" VerticalAlignment="Center"
                           HorizontalAlignment="Center" Cursor="Help"
                           ToolTip="总开关：启用后对所有目标窗口生效压暗与垫黑效果；停用后全部窗口立即还原。"/>
                <Ellipse Grid.Column="2" Width="8" Height="8" Fill="{Binding StatusColor}" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#3ECF8E" BlurRadius="6" ShadowDepth="0"/>
                    </Ellipse.Effect>
                </Ellipse>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding IsEnabled, Mode=TwoWay}"/>
                    <TextBlock Text="启用" Margin="6,0,0,0" FontSize="12" Foreground="{StaticResource Text2}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ ② 目标窗口卡 ═══ -->
        <Border Grid.Row="1" Background="{StaticResource Card}" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="18"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource CardHeader}" CornerRadius="8,8,0,0">
                    <Grid Margin="10,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="84"/>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="92"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="目标窗口" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding BadgeText}" Foreground="{StaticResource Text2}" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <Button Grid.Column="2" Style="{StaticResource BtnBase}" Content="⟳ 刷新快照" FontSize="11" Margin="0,3,4,3" Command="{Binding RefreshSnapshotsCommand}"/>
                        <Button Grid.Column="3" Style="{StaticResource BtnPrimary}" Content="+ 添加窗口" FontSize="11" Margin="0,3,4,3" Command="{Binding AddWindowCommand}"/>
                        <Button Grid.Column="4" Style="{StaticResource BtnBase}" Content="↻ 重新查找" FontSize="11" Margin="0,3,0,3" Command="{Binding RefindAllCommand}"/>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6">
                    <ItemsControl ItemsSource="{Binding Targets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="124" Height="116" Background="{Binding CardBg}" CornerRadius="10" Margin="3"
                                        BorderBrush="{Binding CardBorder}" BorderThickness="1">
                                    <StackPanel Margin="8,8,8,6">
                                        <Border Height="56" CornerRadius="6" Background="{StaticResource ShotBg}">
                                            <Grid>
                                                <Rectangle Fill="{Binding ShotColor}" RadiusX="3" RadiusY="3" Margin="4"/>
                                                <Image Source="{Binding ShotImage}" Stretch="Uniform" Margin="4"/>
                                                <TextBlock Text="⏳ 窗口未启动" FontSize="11" Foreground="{StaticResource Text3}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding PendingLabel}"/>
                                            </Grid>
                                        </Border>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="7" Height="7" Fill="{Binding StateColor}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" Foreground="{Binding NameColor}"/>
                                                <Border Background="#2A2A22" CornerRadius="4" BorderBrush="#5A4A20" BorderThickness="1" Padding="3,0" Margin="5,0,0,0"
                                                        Visibility="{Binding AliasVisible}">
                                                    <TextBlock Text="别名" FontSize="9.5" Foreground="{StaticResource Amber}" VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                            <Button Content="{Binding SelText}" Style="{StaticResource BtnIcon}" Background="{Binding SelBg}"
                                                    Command="{Binding SelectCommand}" IsEnabled="{Binding SelectEnabled}"/>
                                            <Button Content="✎" Style="{StaticResource BtnIcon}" Command="{Binding RenameCommand}"/>
                                            <Button Content="×" Style="{StaticResource BtnIcon}" Command="{Binding RemoveCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Grid.Row="2" Text="▼ 更多目标 · 窗口拉高后卡片自动增行" FontSize="10" Foreground="{StaticResource Text3}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ═══ ③ 效果控制卡 ═══ -->
        <Border Grid.Row="2" Background="{StaticResource Card}" CornerRadius="8" Margin="0,8,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource CardHeader}" CornerRadius="8,8,0,0">
                    <TextBlock Text=" 效果控制" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                </Border>
                <Grid Grid.Row="1" Margin="10,4,10,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Content="垫黑底" IsChecked="{Binding BackdropBlackPlate, Mode=TwoWay}"
                                  ToolTip="在目标窗口正下方垫不透明纯黑，配合半透明形成压暗效果。关闭后目标只变半透明、透出后面内容。"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Content="全局统一压暗" FontWeight="Bold" IsChecked="{Binding GlobalTransparency, Mode=TwoWay}"
                                      ToolTip="所有窗口共用同一压暗强度。关闭后可在目标列表点 ○ 选中窗口单独配置。"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="压暗强度" FontSize="12.5" Foreground="{StaticResource Text2}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding BackgroundAlpha, Mode=TwoWay}"
                                IsEnabled="{Binding IsAlphaSliderEnabled}" VerticalAlignment="Center" Margin="6,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding BackgroundAlphaText}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource Text}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <CheckBox Grid.Row="2" Content="全局统一圆角" FontWeight="Bold" IsChecked="{Binding GlobalCornerRadius, Mode=TwoWay}" VerticalAlignment="Center"
                              ToolTip="所有窗口共用同一圆角。关闭后可在目标列表点 ○ 选中窗口单独配置。"/>
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="圆角半径" FontSize="12.5" Foreground="{StaticResource Text2}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="20" Value="{Binding CornerRadius, Mode=TwoWay}"
                                IsEnabled="{Binding IsCornerSliderEnabled}" VerticalAlignment="Center" Margin="6,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding CornerRadiusText}" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Grid.Row="4" Text="关闭「全局统一」后，点 ○ 选中窗口单独调整" FontSize="11" Foreground="{StaticResource Text3}" VerticalAlignment="Top"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══ ④ 系统卡 ═══ -->
        <Border Grid.Row="3" Background="{StaticResource Card}" CornerRadius="8" Padding="14,0" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="26"/>
                </Grid.ColumnDefinitions>
                <CheckBox Content="开机自启" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" VerticalAlignment="Center"
                          ToolTip="登录 Windows 时自动启动本程序（写入注册表 Run 项）。"/>
                <CheckBox Grid.Column="1" Content="关闭时最小化到托盘" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" Margin="18,0,0,0" VerticalAlignment="Center"
                          ToolTip="勾选后点关闭按钮最小化到托盘常驻；不勾选则直接退出程序。"/>
                <TextBlock Grid.Column="3" Text="ⓘ" FontSize="13" Foreground="{StaticResource Text3}" VerticalAlignment="Center"
                           HorizontalAlignment="Center" Cursor="Help"
                           ToolTip="所有说明文字悬停 ⓘ 即可查看。"/>
            </Grid>
        </Border>

        <!-- ═══ ⑤ 操作栏 ═══ -->
        <Border Grid.Row="4" Background="{StaticResource Card}" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource BtnBase}" Content="📂 配置文件夹" Margin="0,0,6,0" Command="{Binding OpenConfigFolderCommand}"/>
                    <Button Style="{StaticResource BtnBase}" Content="ℹ 关于" Command="{Binding AboutCommand}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource BtnPrimary}" Content="💾 保存配置" Margin="0,0,6,0" Command="{Binding SaveCommand}"/>
                    <Button Style="{StaticResource BtnDanger}" Content="🚪 退出" Command="{Binding ExitCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ ⑥ 页脚 ═══ -->
        <TextBlock Grid.Row="5" Text="20260720 · 世界的风吹向你 · 开源软件  |  GitHub →" FontSize="10.5"
                   Foreground="{StaticResource Text3}" VerticalAlignment="Center" Margin="4,0,0,0" Cursor="Hand"
                   ToolTip="https://github.com/Simiely/WindowTinter"/>
    </Grid>
</Window>
