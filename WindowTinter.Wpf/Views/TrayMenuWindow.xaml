<Window x:Class="WindowTinter.Views.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="220" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False" Topmost="True" Focusable="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI">
    <Border Background="#1E2024" BorderBrush="#3A3F46" BorderThickness="1" CornerRadius="8" Padding="0,6">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="2" Opacity="0.6"/>
        </Border.Effect>
        <StackPanel x:Name="Panel" Margin="0"/>
    </Border>
</Window>