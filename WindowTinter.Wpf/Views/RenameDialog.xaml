<Window x:Class="WindowTinter.Views.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重命名窗口" Width="360" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Card}"
        UseLayoutRounding="True">
    <StackPanel Margin="14" Width="330">
        <TextBlock Text="显示名称（留空恢复默认）：" Foreground="{StaticResource Text2}" FontSize="12"/>
        <TextBox x:Name="Input" Margin="0,8,0,0" Height="26" Padding="6,3" FontSize="12"
                 Background="#3A3F46" Foreground="{StaticResource Text}"
                 BorderBrush="{StaticResource Border}" CaretBrush="{StaticResource Text}"
                 SelectionBrush="{StaticResource Blue}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="确定" Style="{StaticResource BtnPrimary}" Width="76" Height="28" IsDefault="True" Click="OnOk"/>
            <Button Content="取消" Style="{StaticResource BtnBase}" Width="76" Height="28" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
