<Window x:Class="WindowTinter.Views.WindowPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="拾取目标窗口" WindowStyle="None" AllowsTransparency="True" Background="#01000000"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI" Foreground="{StaticResource Text1}"
        MouseMove="OnMouseMove" MouseLeftButtonUp="OnMouseClick" KeyDown="OnKeyDown">

    <!--
        根层铺 1/255 不透明黑（视觉上不可见）：AllowsTransparency 的分层窗口按像素 alpha 做命中测试，
        alpha=0 的区域会把鼠标消息透传给下层窗口——「挖空」的目标区域一旦透明，点击就落到了目标窗口，
        本拾取器收不到 MouseLeftButtonUp / MouseMove，表现为"点拾取选不中目标"。
        alpha=1 让整屏都可命中：点击不会触发目标窗口，也一定回到本窗口。
    -->
    <Grid Background="#01000000">
        <!-- 全屏 scrim：四块遮罩拼出目标窗口的"挖空"区域 -->
        <Canvas>
            <Rectangle x:Name="TopScrim" Fill="#8508090C"/>
            <Rectangle x:Name="BottomScrim" Fill="#8508090C"/>
            <Rectangle x:Name="LeftScrim" Fill="#8508090C"/>
            <Rectangle x:Name="RightScrim" Fill="#8508090C"/>

            <!-- 目标高亮：2px 蓝描边 + 四角标 + 尺寸标签 -->
            <Canvas x:Name="TargetFrame" Visibility="Collapsed" IsHitTestVisible="False">
                <Grid x:Name="FrameVisual" Width="200" Height="120">
                    <Border BorderBrush="#E60A84FF" BorderThickness="2" CornerRadius="7"/>
                    <Border BorderBrush="#330A84FF" BorderThickness="6" CornerRadius="10" Margin="-4"/>

                    <Path HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-9,-9,0,0" Width="22" Height="22"
                          Data="M2,20 L2,2 L20,2" Stroke="{StaticResource Accent}" StrokeThickness="3" StrokeLineJoin="Round"/>
                    <Path HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-9,-9,0" Width="22" Height="22"
                          Data="M0,2 L18,2 L18,20" Stroke="{StaticResource Accent}" StrokeThickness="3" StrokeLineJoin="Round"/>
                    <Path HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-9,0,0,-9" Width="22" Height="22"
                          Data="M2,0 L2,18 L20,18" Stroke="{StaticResource Accent}" StrokeThickness="3" StrokeLineJoin="Round"/>
                    <Path HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-9,-9" Width="22" Height="22"
                          Data="M0,18 L18,18 L18,0" Stroke="{StaticResource Accent}" StrokeThickness="3" StrokeLineJoin="Round"/>

                    <Border x:Name="TargetLabel" Background="#E60C0D10" BorderBrush="#29FFFFFF" BorderThickness="1"
                            CornerRadius="7" Padding="9,4" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="0,-36,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TargetLabelText" FontSize="10" Foreground="{StaticResource Text1}"/>
                            <TextBlock x:Name="TargetLabelSize" FontSize="9" Foreground="{StaticResource Text3}"
                                       Margin="8,1,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Canvas>
        </Canvas>

        <!-- 左侧 HUD（宽 304，避开目标窗自动换边） -->
        <Canvas>
            <Border x:Name="Hud" Width="304" Canvas.Left="16" Canvas.Top="32" Background="#F226262A"
                    BorderBrush="#29FFFFFF" BorderThickness="1" CornerRadius="14" Padding="16">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="10" Opacity="0.55"/>
                </Border.Effect>
                <StackPanel>
                    <!-- 头部 -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="10" Background="#1FFF453A" BorderBrush="#4DFF453A"
                                BorderThickness="1" VerticalAlignment="Center">
                            <Path Width="18" Height="18" Stroke="{StaticResource Accent}" StrokeThickness="1.6"
                                  Data="M9,1 A8,8 0 0 1 17,9 M9,17 A8,8 0 0 1 1,9 M9,1 A8,8 0 0 0 1,9 M9,17 A8,8 0 0 0 17,9"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="拾取目标窗口" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="把鼠标移到想压暗的窗口上" FontSize="9.5" Foreground="{StaticResource Text3}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" Height="20" CornerRadius="5" Background="{StaticResource InsetBg}"
                                BorderBrush="{StaticResource LineSoftHover}" BorderThickness="1" Padding="7,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="Esc" FontSize="9" Foreground="{StaticResource Text3}" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- 实时命中卡片 -->
                    <Border Background="{StaticResource InsetBg}" BorderBrush="{StaticResource LineSoft}" BorderThickness="1"
                            CornerRadius="9" Padding="12,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="HudDot" Grid.Column="0" Width="6" Height="6" Fill="{StaticResource Off}"
                                     VerticalAlignment="Top" Margin="0,5,0,0"/>
                            <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                <TextBlock x:Name="HudTitle" Text="移动鼠标选择目标" FontSize="11" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="HudMeta" Text="尚未命中任何窗口" FontSize="9" Foreground="{StaticResource Text3}"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Border Grid.Column="2" Height="18" CornerRadius="4" Background="{StaticResource BadgeBg}"
                                    BorderBrush="{StaticResource BadgeBorder}" BorderThickness="1" Padding="5,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="待绑定" FontSize="8.5" Foreground="{StaticResource BadgeText}" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 操作 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="取消" Style="{StaticResource BtnBase}" Height="28" FontSize="10.5"
                                Click="OnCancelHud"/>
                        <Button x:Name="ConfirmButton" Grid.Column="1" Content="绑定此窗口" Style="{StaticResource BtnPrimary}"
                                Height="28" FontSize="10.5" Margin="8,0,0,0" Click="OnConfirmHud" IsEnabled="False"/>
                    </Grid>

                    <TextBlock Text="单击窗口任意位置确认 · Esc 取消" FontSize="9" Foreground="{StaticResource Text3}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="仅作用于所选窗口" FontSize="9" Foreground="{StaticResource Text3}"
                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
