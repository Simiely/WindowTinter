<Window x:Class="WindowTinter.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="488" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI" Foreground="{StaticResource Text1}">

    <Border Margin="16" Background="#26262A" BorderBrush="#29FFFFFF" BorderThickness="1" CornerRadius="23">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.6"/>
        </Border.Effect>

        <StackPanel>
            <!-- 头部 52 -->
            <Grid Height="52" Background="Transparent" MouseLeftButtonDown="OnHeaderDrag">
                <TextBlock Text="设置" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="20,0,0,0"/>
                <Button Style="{StaticResource BtnIcon}" Width="28" Height="28" HorizontalAlignment="Right" Margin="0,0,12,0"
                        Click="OnCloseClick" ToolTip="关闭">
                    <TextBlock Text="✕" FontSize="12" Foreground="{StaticResource Text3}"/>
                </Button>
                <Border Height="1" Background="{StaticResource LineSoft}" VerticalAlignment="Bottom"/>
            </Grid>

            <!-- 只读提示：全局参数入口已移到主窗口底部，避免两处入口 -->
            <Border Background="{StaticResource AccentSoft}" BorderBrush="#4D0A84FF" BorderThickness="1" CornerRadius="9"
                    Margin="20,12,20,0" Padding="12,10">
                <StackPanel>
                    <TextBlock Text="压暗强度与圆角半径" FontSize="11.5" FontWeight="SemiBold"/>
                    <TextBlock Text="已移至主窗口底部「全局默认」面板：那里调整只作用于仍跟随全局的卡片；已自定义的卡片保持自己的值，不再跟随。推荐 14 px（Windows 11 观感最佳）。"
                               FontSize="9.5" Foreground="{StaticResource Text2}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <!-- 参数区 -->
            <StackPanel Margin="20,16,20,18">

                <Border Background="#14FFFFFF" BorderBrush="{StaticResource LineSoft}" BorderThickness="1" CornerRadius="9"
                        Height="48" Padding="12,0" Margin="0,0,0,0">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="黑色底板" FontSize="11.5"/>
                            <TextBlock Text="在目标窗口正下方垫不透明纯黑，配合半透明形成压暗效果" FontSize="9" Foreground="{StaticResource Text3}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      IsChecked="{Binding BackdropBlackPlate, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <Border Background="#14FFFFFF" BorderBrush="{StaticResource LineSoft}" BorderThickness="1" CornerRadius="9"
                        Height="48" Padding="12,0" Margin="0,8,0,0"
                        ToolTip="双列时每张卡片约占半行宽；展开的卡片会自动占满整行，保证滑块行程够用。切换即时生效。">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="每行卡片数" FontSize="11.5"/>
                            <TextBlock Text="单列信息更全；双列更紧凑（悬停查看说明）" FontSize="9" Foreground="{StaticResource Text3}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#0BFFFFFF"
                                BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="8" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton Style="{StaticResource SegToggle}" Content="1 张" Margin="0,0,2,0"
                                              IsChecked="{Binding IsOnePerRow, Mode=TwoWay}"/>
                                <ToggleButton Style="{StaticResource SegToggle}" Content="2 张"
                                              IsChecked="{Binding IsTwoPerRow, Mode=TwoWay}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Background="#14FFFFFF" BorderBrush="{StaticResource LineSoft}" BorderThickness="1" CornerRadius="9"
                        Height="48" Padding="12,0" Margin="0,8,0,0">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="开机自启" FontSize="11.5"/>
                            <TextBlock Text="登录 Windows 后自动启动并恢复已绑定目标" FontSize="9" Foreground="{StaticResource Text3}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      IsChecked="{Binding StartWithWindows, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <Border Background="#14FFFFFF" BorderBrush="{StaticResource LineSoft}" BorderThickness="1" CornerRadius="9"
                        Height="48" Padding="12,0" Margin="0,8,0,0">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="关闭窗口时最小化到托盘" FontSize="11.5"/>
                            <TextBlock Text="关闭主窗口不退出程序，压暗效果继续运行" FontSize="9" Foreground="{StaticResource Text3}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 底栏 -->
            <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Padding="16,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="配置文件夹" Style="{StaticResource LinkButton}" Command="{Binding OpenConfigFolderCommand}"/>
                        <Button Content="关于" Style="{StaticResource LinkButton}" Margin="8,0,0,0" Command="{Binding AboutCommand}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="恢复默认" Style="{StaticResource BtnBase}" Height="28" FontSize="10.5" Margin="0,0,8,0"
                                Command="{Binding ResetDefaultsCommand}"/>
                        <Button Content="完成" Style="{StaticResource BtnPrimary}" Height="28" FontSize="10.5" Width="72"
                                IsDefault="True" Click="OnCloseClick"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
