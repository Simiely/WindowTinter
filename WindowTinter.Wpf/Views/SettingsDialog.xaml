<Window x:Class="WindowTinter.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="全局默认参数" Width="488" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI" Foreground="{StaticResource Text1}">

    <Border Margin="16" Background="#26262A" BorderBrush="#29FFFFFF" BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.6"/>
        </Border.Effect>

        <StackPanel>
            <!-- 头部 52 -->
            <Grid Height="52" Background="Transparent" MouseLeftButtonDown="OnHeaderDrag">
                <TextBlock Text="全局默认参数" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="20,0,0,0"/>
                <Button Style="{StaticResource BtnIcon}" Width="28" Height="28" HorizontalAlignment="Right" Margin="0,0,12,0"
                        Click="OnCloseClick" ToolTip="关闭">
                    <TextBlock Text="✕" FontSize="12" Foreground="{StaticResource Text3}"/>
                </Button>
                <Border Height="1" Background="{StaticResource LineSoft}" VerticalAlignment="Bottom"/>
            </Grid>

            <!-- 副标题 -->
            <TextBlock Text="仅影响新绑定目标；已绑定目标可在卡片内单独调整。"
                       FontSize="10" Foreground="{StaticResource Text3}" TextWrapping="Wrap" Margin="20,12,20,0"/>

            <!-- 参数区 -->
            <StackPanel Margin="20,16,20,18">

                <Grid Height="24">
                    <TextBlock Text="背景暗度" FontSize="11.5" Foreground="{StaticResource Text1}" VerticalAlignment="Center"/>
                    <Border HorizontalAlignment="Right" Height="20" MinWidth="40" CornerRadius="5" Background="{StaticResource InsetBg}"
                            BorderBrush="{StaticResource LineSoftHover}" BorderThickness="1" Padding="6,0">
                        <TextBlock Text="{Binding GlobalAlphaText}" FontSize="10" Foreground="{StaticResource Text2}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="5" Margin="0,2,0,0"
                        Value="{Binding GlobalAlpha, Mode=TwoWay}"/>
                <TextBlock Text="遮罩底色不透明度。0% = 完全透明，100% = 纯黑不透视。"
                           FontSize="9.5" Foreground="{StaticResource Text3}" Margin="0,6,0,0" TextWrapping="Wrap"/>

                <Grid Height="24" Margin="0,16,0,0">
                    <TextBlock Text="圆角半径" FontSize="11.5" Foreground="{StaticResource Text1}" VerticalAlignment="Center"/>
                    <Border HorizontalAlignment="Right" Height="20" MinWidth="40" CornerRadius="5" Background="{StaticResource InsetBg}"
                            BorderBrush="{StaticResource LineSoftHover}" BorderThickness="1" Padding="6,0">
                        <TextBlock Text="{Binding GlobalCornerText}" FontSize="10" Foreground="{StaticResource Text2}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                <Slider Minimum="0" Maximum="32" SmallChange="1" LargeChange="4" Margin="0,2,0,0"
                        Value="{Binding GlobalCorner, Mode=TwoWay}"/>
                <TextBlock Text="黑板四角圆角。0 = 直角；建议 8–16 px，与窗口自身圆角接近时边缘最干净。"
                           FontSize="9.5" Foreground="{StaticResource Text3}" Margin="0,6,0,0" TextWrapping="Wrap"/>

                <!-- 开关行 -->
                <Border Background="#14FFFFFF" BorderBrush="{StaticResource LineSoft}" BorderThickness="1" CornerRadius="9"
                        Height="48" Padding="12,0" Margin="0,16,0,0">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="黑色底板" FontSize="11.5"/>
                            <TextBlock Text="在目标窗口正下方垫不透明纯黑，配合半透明形成压暗效果" FontSize="9" Foreground="{StaticResource Text3}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      IsChecked="{Binding BackdropBlackPlate, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <Border Background="#14FFFFFF" BorderBrush="{StaticResource LineSoft}" BorderThickness="1" CornerRadius="9"
                        Height="48" Padding="12,0" Margin="0,8,0,0">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="全局统一压暗" FontSize="11.5"/>
                            <TextBlock Text="所有目标共用同一暗度；关闭后可逐张卡片调整" FontSize="9" Foreground="{StaticResource Text3}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      IsChecked="{Binding GlobalTransparency, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <Border Background="#14FFFFFF" BorderBrush="{StaticResource LineSoft}" BorderThickness="1" CornerRadius="9"
                        Height="48" Padding="12,0" Margin="0,8,0,0">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="全局统一圆角" FontSize="11.5"/>
                            <TextBlock Text="所有目标共用同一圆角；关闭后可逐张卡片调整" FontSize="9" Foreground="{StaticResource Text3}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      IsChecked="{Binding GlobalCornerRadius, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <Border Background="#14FFFFFF" BorderBrush="{StaticResource LineSoft}" BorderThickness="1" CornerRadius="9"
                        Height="48" Padding="12,0" Margin="0,8,0,0">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="开机自启" FontSize="11.5"/>
                            <TextBlock Text="登录 Windows 后自动启动并恢复已绑定目标" FontSize="9" Foreground="{StaticResource Text3}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      IsChecked="{Binding StartWithWindows, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <Border Background="#14FFFFFF" BorderBrush="{StaticResource LineSoft}" BorderThickness="1" CornerRadius="9"
                        Height="48" Padding="12,0" Margin="0,8,0,0">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="关闭窗口时最小化到托盘" FontSize="11.5"/>
                            <TextBlock Text="关闭主窗口不退出程序，压暗效果继续运行" FontSize="9" Foreground="{StaticResource Text3}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 底栏 -->
            <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Padding="16,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="配置文件夹" Style="{StaticResource LinkButton}" Command="{Binding OpenConfigFolderCommand}"/>
                        <Button Content="关于" Style="{StaticResource LinkButton}" Margin="8,0,0,0" Command="{Binding AboutCommand}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="恢复默认" Style="{StaticResource BtnBase}" Height="28" FontSize="10.5" Margin="0,0,8,0"
                                Command="{Binding ResetDefaultsCommand}"/>
                        <Button Content="完成" Style="{StaticResource BtnPrimary}" Height="28" FontSize="10.5" Width="72"
                                IsDefault="True" Click="OnCloseClick"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
